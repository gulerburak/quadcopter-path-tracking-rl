# Training output. Checkpoints are large and are not part of the deliverable, but
# models/capstone_s0/ ships on purpose so the repo is runnable on clone, and the
# per-stage evaluations.npz files ship so the learning curves can be rebuilt.
runs/
logs/
models/*
!models/capstone_s0/
results/
results_matrix/models/*/*/*.zip
results_matrix/models/*/*/*/*.zip
results_matrix/logs/
results_sensitivity/models/*/*/*.zip
results_sensitivity/models/*/*/*/*.zip
results_sensitivity/logs/

# Generated by tools/build_*.py. The canonical copies live with the report;
# these are rebuildable from the committed CSVs at any time.
report/figures/
